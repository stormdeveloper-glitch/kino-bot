# BotFather dan olingan token (MAJBURIY)
BOT_TOKEN=1234567890:ABCDefGhIJKlmNoPQRsTUVwxyZ

# Admin Telegram ID lari (vergul bilan ajrating) (MAJBURIY)
# ID ni @userinfobot orqali bilib olishingiz mumkin
ADMIN_IDS=123456789,987654321

# Data saqlash manzili (Railway Volume uchun /app/data)
DATA_DIR=/app/data
